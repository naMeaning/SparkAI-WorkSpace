# CRM API production-style example.
# Copy to your process manager or deployment secret store; do not commit real values.

NODE_ENV=production
CRM_API_PORT=17861
CRM_API_HOST=127.0.0.1

# Persistent CRM database. The migrate script creates CRM_DATABASE_NAME if needed.
CRM_DATABASE_URL=mysql://crm_user:change-me@127.0.0.1:3306/ai_native_crm
CRM_DATABASE_NAME=ai_native_crm

# New API service endpoint. Browser clients must never receive these service credentials.
NEW_API_BASE_URL=http://127.0.0.1:17860
NEW_API_ADMIN_USER_ID=1
NEW_API_ADMIN_ACCESS_TOKEN=replace-with-new-api-admin-access-token

# RMB to new-api quota conversion. Keep this aligned with new-api quota settings.
CRM_QUOTA_PER_RMB=500000

# Embedded identity trust and browser origin policy. Keep this identical to the gateway.
CRM_EMBED_TRUST_SECRET=replace-with-at-least-32-random-characters
CRM_ALLOWED_ORIGINS=https://crm.example.com,https://studio.example.com

# Background maintenance. Set to 0 only for local debugging.
CRM_USAGE_SYNC_MAINTENANCE_INTERVAL_MINUTES=15
CRM_EFFECTIVE_CUSTOMER_MAINTENANCE_INTERVAL_MINUTES=60
CRM_ENTERPRISE_MONTHLY_SETTLEMENT_INTERVAL_MINUTES=1440

# Evidence attachment storage. Mount this path on persistent storage in production.
CRM_ATTACHMENT_STORAGE_DIR=/var/lib/ai-native/crm-api/attachments
CRM_ATTACHMENT_MAX_BYTES=5242880

# Real-service smoke. Use existing new-api users in a disposable test environment.
CRM_SMOKE_BASE_URL=http://127.0.0.1:17861
CRM_SMOKE_EMBED_TRUST_SECRET=replace-with-same-value-as-CRM_EMBED_TRUST_SECRET
CRM_SMOKE_ADMIN_NEW_API_USER_ID=1
CRM_SMOKE_ADMIN_USERNAME=root
CRM_SMOKE_USER_NEW_API_USER_ID=2002
CRM_SMOKE_USERNAME=crm-smoke-user
CRM_SMOKE_STRICT=1
