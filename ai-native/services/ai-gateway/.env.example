# AI gateway / embedded new-api production-style example.
# Copy to your process manager or deployment secret store; do not commit real values.

IIIMAGE_SERVER_PORT=17860
AI_GATEWAY_DATA_DIR=/var/lib/ai-native/ai-gateway/new-api

# new-api runtime settings passed through by services/ai-gateway/server.cjs.
SESSION_SECRET=replace-with-at-least-32-random-characters
GENERATE_DEFAULT_TOKEN=false
GIN_MODE=release

# Optional: use the embedded SQLite path under AI_GATEWAY_DATA_DIR by default.
# SQLITE_PATH=/var/lib/ai-native/ai-gateway/new-api/one-api.db?_busy_timeout=30000
