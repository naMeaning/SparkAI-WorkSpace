# Caddy-in-Docker example. Caddy, New API and the extension must share the
# external network configured by SPARKAI_DOCKER_NETWORK.
@sparkai_extension path /api/naimage/license /api/naimage/license/* /v1/image-tasks /v1/image-tasks/*
handle @sparkai_extension {
  reverse_proxy sparkai-extension:17910
}

# Keep the existing upstream and all of its native routes unchanged.
handle {
  reverse_proxy new-api:3000
}
