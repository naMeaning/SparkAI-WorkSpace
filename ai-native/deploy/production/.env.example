# Copy this file to deploy/production/runtime/.env on the server.
# Keep the real file inside the project runtime directory and never commit it.

IIIMAGE_SESSION_SECRET=replace-with-at-least-32-random-characters
IIIMAGE_CRM_EMBED_TRUST_SECRET=replace-with-a-different-32-character-secret
IIIMAGE_NEW_API_ADMIN_ACCESS_TOKEN=replace-with-new-api-admin-access-token
IIIMAGE_CRM_MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
IIIMAGE_CRM_MYSQL_PASSWORD=replace-with-strong-crm-password

# Caddy reaches new-api through this explicitly trusted Docker network only.
IIIMAGE_TRUSTED_PROXIES=172.19.0.0/16

# Download protection. These defaults permit normal shared-network use while
# limiting automated redistribution and repeated abuse.
IIIMAGE_DESKTOP_DOWNLOAD_IP_HOURLY_LIMIT=8
IIIMAGE_DESKTOP_DOWNLOAD_IP_DAILY_LIMIT=30
IIIMAGE_DESKTOP_DOWNLOAD_USER_HOURLY_LIMIT=5
IIIMAGE_DESKTOP_DOWNLOAD_USER_DAILY_LIMIT=20
IIIMAGE_DESKTOP_CAPTCHA_IP_10M_LIMIT=20
IIIMAGE_DESKTOP_CAPTCHA_USER_10M_LIMIT=15
IIIMAGE_DESKTOP_UPDATE_IP_HOURLY_LIMIT=12
IIIMAGE_DESKTOP_UPDATE_IP_DAILY_LIMIT=50
IIIMAGE_DESKTOP_UPDATE_USER_HOURLY_LIMIT=8
IIIMAGE_DESKTOP_UPDATE_USER_DAILY_LIMIT=30
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_TTL_MINUTES=60
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_PROCESSING_MINUTES=15
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_RESPONSE_MB=64
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_TOTAL_MB=8192
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_RECORDS=10000
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_USER_RECORDS=1000
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_USER_TOTAL_MB=1024
IIIMAGE_MANAGED_IMAGE_IDEMPOTENCY_CLEANUP_BATCH=500

# Persistent data remains outside Git; configuration remains in this project.
IIIMAGE_DATA_ROOT=/opt/iiimage/data
IIIMAGE_LOG_ROOT=/opt/iiimage/logs
