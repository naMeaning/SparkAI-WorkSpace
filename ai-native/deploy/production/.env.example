# Copy this file to deploy/production/runtime/.env on the server.
# Keep the real file inside the project runtime directory and never commit it.
# NAIMAGE_* is canonical. Existing IIIMAGE_* values remain supported by the
# Compose and operations scripts so a brand release does not rotate secrets.

NAIMAGE_SESSION_SECRET=replace-with-at-least-32-random-characters
NAIMAGE_CRM_EMBED_TRUST_SECRET=replace-with-a-different-32-character-secret
NAIMAGE_NEW_API_ADMIN_ACCESS_TOKEN=replace-with-new-api-admin-access-token
NAIMAGE_CRM_MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
NAIMAGE_CRM_MYSQL_PASSWORD=replace-with-strong-crm-password

# Caddy reaches new-api through this explicitly trusted Docker network only.
NAIMAGE_TRUSTED_PROXIES=172.19.0.0/16

# Download protection. These defaults permit normal shared-network use while
# limiting automated redistribution and repeated abuse.
NAIMAGE_DESKTOP_DOWNLOAD_IP_HOURLY_LIMIT=8
NAIMAGE_DESKTOP_DOWNLOAD_IP_DAILY_LIMIT=30
NAIMAGE_DESKTOP_DOWNLOAD_USER_HOURLY_LIMIT=5
NAIMAGE_DESKTOP_DOWNLOAD_USER_DAILY_LIMIT=20
NAIMAGE_DESKTOP_CAPTCHA_IP_10M_LIMIT=20
NAIMAGE_DESKTOP_CAPTCHA_USER_10M_LIMIT=15
NAIMAGE_DESKTOP_UPDATE_IP_HOURLY_LIMIT=12
NAIMAGE_DESKTOP_UPDATE_IP_DAILY_LIMIT=50
NAIMAGE_DESKTOP_UPDATE_USER_HOURLY_LIMIT=8
NAIMAGE_DESKTOP_UPDATE_USER_DAILY_LIMIT=30
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_TTL_MINUTES=60
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_PROCESSING_MINUTES=15
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_RESPONSE_MB=64
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_TOTAL_MB=8192
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_RECORDS=10000
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_USER_RECORDS=1000
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_MAX_USER_TOTAL_MB=1024
NAIMAGE_MANAGED_IMAGE_IDEMPOTENCY_CLEANUP_BATCH=500

# Persistent data keeps the existing physical ABI for this release. Moving
# these directories requires a separate, backed-up maintenance window.
NAIMAGE_DATA_ROOT=/opt/iiimage/data
NAIMAGE_LOG_ROOT=/opt/iiimage/logs
