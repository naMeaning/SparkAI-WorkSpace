# Compose interpolation compatibility only; never place secrets in this file.
# The runtime .env is loaded first. Canonical NAIMAGE_* values win, while an
# existing IIIMAGE_* deployment continues to resolve to the same secret.
NAIMAGE_SESSION_SECRET=${NAIMAGE_SESSION_SECRET:-${IIIMAGE_SESSION_SECRET:-}}
NAIMAGE_CRM_EMBED_TRUST_SECRET=${NAIMAGE_CRM_EMBED_TRUST_SECRET:-${IIIMAGE_CRM_EMBED_TRUST_SECRET:-}}
NAIMAGE_NEW_API_ADMIN_ACCESS_TOKEN=${NAIMAGE_NEW_API_ADMIN_ACCESS_TOKEN:-${IIIMAGE_NEW_API_ADMIN_ACCESS_TOKEN:-}}
NAIMAGE_CRM_MYSQL_ROOT_PASSWORD=${NAIMAGE_CRM_MYSQL_ROOT_PASSWORD:-${IIIMAGE_CRM_MYSQL_ROOT_PASSWORD:-}}
NAIMAGE_CRM_MYSQL_PASSWORD=${NAIMAGE_CRM_MYSQL_PASSWORD:-${IIIMAGE_CRM_MYSQL_PASSWORD:-}}
