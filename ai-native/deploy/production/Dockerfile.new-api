FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS web-builder

WORKDIR /build
COPY services/ai-gateway/new-api/web/package.json services/ai-gateway/new-api/web/bun.lock ./services/ai-gateway/new-api/web/
COPY services/ai-gateway/new-api/web/default/package.json ./services/ai-gateway/new-api/web/default/package.json
COPY packages/crm-contracts/package.json ./packages/crm-contracts/package.json
COPY packages/crm-contracts/src ./packages/crm-contracts/src
WORKDIR /build/services/ai-gateway/new-api/web
RUN bun install --frozen-lockfile
COPY services/ai-gateway/new-api/web/default ./default
COPY services/ai-gateway/new-api/VERSION /build/services/ai-gateway/new-api/VERSION
RUN cd default && DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat ../../VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS go-builder
ENV GO111MODULE=on CGO_ENABLED=0
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build/services/ai-gateway/new-api
COPY services/ai-gateway/new-api/go.mod services/ai-gateway/new-api/go.sum ./
RUN go mod download
COPY services/ai-gateway/new-api ./
COPY --from=web-builder /build/services/ai-gateway/new-api/web/default/dist ./web/default/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

# New API rc.21 refuses secure session cookies without an explicit HTTPS
# origin. This production image is dedicated to image.aieyra.cn; Compose may
# still override the value for a reviewed domain migration.
ENV SESSION_COOKIE_TRUSTED_URL=https://image.aieyra.cn

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 sqlite3 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=go-builder /build/services/ai-gateway/new-api/new-api /
COPY services/ai-gateway/new-api/LICENSE services/ai-gateway/new-api/NOTICE services/ai-gateway/new-api/THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
