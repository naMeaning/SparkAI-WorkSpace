  summary: string; fingerprint: string };
export type ProjectKnowledgeReceipt = { version: 1; projectId: string; revision: number; fingerprint: string; objects: ProjectKnowledgeScope[];
  entries: { knowledgeId: string; revision: number; fingerprint: string; authority: "project_knowledge" | "commerce_catalog"; catalogRef?: ProjectKnowledgeCatalogRef }[];
  summary: string; omittedEntries: number };
