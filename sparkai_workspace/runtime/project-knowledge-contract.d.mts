export type ProjectKnowledgeScope = { type: "project" } | { type: "product"; productId: string } |
  { type: "variant"; productId: string; variantId: string } | { type: "sku"; productId: string; skuId: string };
export type ProjectKnowledgeAsset = { assetId: string; occurrenceId: string; contentHash: string };
export type ProjectKnowledgeScopeOption = { scope: ProjectKnowledgeScope; label: string };
export type ProjectKnowledgeType = "brand_rule" | "product_fact" | "prohibited_expression" | "style_reference" | "preference";
export type ProjectKnowledgeStatus = "active" | "suggested" | "inactive" | "deleted";
export type ProjectKnowledgeCatalogRef = { catalogId: string; catalogRevision: number; productId: string;
  productRevision: number; field: "product" | "brandStyle" | "variant" | "sku"; ownerRevision?: number };
export type ProjectKnowledgeEntry = { knowledgeId: string; revision: number; type: ProjectKnowledgeType; title: string; content: string;
  scope: ProjectKnowledgeScope; source: "user" | "assumption"; status: ProjectKnowledgeStatus;
  authority: "project_knowledge" | "commerce_catalog"; assetRefs: ProjectKnowledgeAsset[]; fingerprint: string;
  catalogRef?: ProjectKnowledgeCatalogRef; readOnly?: true };
export type ProjectKnowledgeSnapshot = { version: 1; projectId: string; revision: number; objects: ProjectKnowledgeScope[];
