{
  "name": "@naimage/studio",
  "version": "1.0.6",
  "productName": "naimage",
  "description": "A single-Agent AI image studio with an infinite visual canvas.",
  "author": "SparkAI",
  "license": "UNLICENSED",
  "naimageUpdateCompatibility": "windows-x64-electron-42-runtime-3",
  "naimageUpdateMinimumVersion": "1.0.5",
  "main": "electron-main.cjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:launcher": "dotnet publish tools/dev-launcher/naimage.Studio.DevLauncher.csproj -c Release -r win-x64 --self-contained false -o .release-tools/dev-launcher",
    "aidebug:gui": "node scripts/aidebug-gui.mjs --quick-smoke --mock-agent",
    "aidebug:gui:surface": "node scripts/aidebug-gui.mjs --mock-agent",
    "aidebug:evidence": "node scripts/aidebug-evidence-audit.mjs",
    "aidebug:performance": "node scripts/aidebug-gui.mjs --performance-suite --mock-agent",
    "aidebug:performance:audit": "node scripts/performance-evidence-audit.mjs",
    "aidebug:performance:audit:strict": "node scripts/performance-evidence-audit.mjs --strict",
    "aidebug:performance:audit:test": "node --test scripts/performance-evidence-audit.test.mjs",
    "aidebug:performance:product": "node scripts/product-performance-gate.mjs",
    "aidebug:image-recovery": "node scripts/aidebug-gui.mjs --image-recovery-suite --mock-agent",
    "aidebug:image-import": "node scripts/aidebug-gui.mjs --image-import-suite --mock-agent",
    "aidebug:canvas-clarity": "node scripts/aidebug-gui.mjs --canvas-clarity-suite --mock-agent",
    "aidebug:menus": "node scripts/aidebug-gui.mjs --context-menu-suite --mock-agent",
    "aidebug:selection": "node scripts/aidebug-gui.mjs --selection-command-suite --mock-agent",
    "aidebug:requirements": "node scripts/aidebug-gui.mjs --requirement-node-suite --mock-agent",
    "aidebug:requirements:full": "node scripts/aidebug-gui.mjs --requirement-node-suite --mock-agent --full-suite",
    "aidebug:ask-user": "node scripts/aidebug-gui.mjs --ask-user-continuation-suite --mock-agent",
    "aidebug:human": "node scripts/aidebug-human-suite.mjs",
    "aidebug:human:list": "node scripts/aidebug-human-suite.mjs --list-suites",
    "archive:images": "node scripts/archive-image-showcase.mjs",
    "maintenance:clean": "node scripts/maintenance/clean-workspace.mjs",
    "maintenance:clean:apply": "node scripts/maintenance/clean-workspace.mjs --apply",
    "test:agent-text": "node scripts/agent-text-config-selftest.cjs",
    "test:agent-protocol": "electron scripts/agent-protocol-selftest.cjs",
    "test:agent-responses-adapter": "node scripts/agent-responses-adapter-selftest.cjs",
    "test:context-strategy": "node scripts/context-strategy-selftest.cjs",
    "test:context-checkpoint": "node scripts/context-checkpoint-selftest.cjs",
    "test:agent-panel-layout": "node scripts/agent-panel-layout-selftest.ts",
    "test:agent-panel-ui": "node scripts/agent-panel-ui-selftest.mjs",
    "test:agent-window": "node scripts/agent-window-service-selftest.cjs && node scripts/agent-window-sync-selftest.ts",
    "test:agent-window-ui": "node scripts/agent-window-ui-selftest.mjs",
    "test:controlled-shell-command": "node scripts/controlled-shell-command-selftest.cjs",
    "test:new-api-transport": "electron scripts/new-api-transport-selftest.cjs",
    "test:custom-api-transport": "node scripts/custom-api-transport-selftest.cjs",
    "test:license": "node scripts/license-service-selftest.cjs",
    "test:view-image": "node scripts/view-image-payload-selftest.cjs",
    "test:project-io": "electron scripts/project-io-selftest.cjs",
    "test:project-save-coordinator": "node scripts/project-save-coordinator-selftest.cjs",
    "test:model-catalog": "node scripts/model-catalog-selftest.cjs",
    "test:settings-persistence": "node scripts/settings-persistence-selftest.ts",
    "test:settings-lazy-load": "node scripts/settings-lazy-load-selftest.cjs",
    "test:paste-blocks": "node scripts/paste-block-selftest.ts",
    "test:agent-text-ui": "node scripts/agent-text-ui-aidebug.mjs",
    "test:aidebug-agent-fixtures": "node scripts/aidebug-agent-fixture-bridge-selftest.ts",
    "test:aidebug-options": "node scripts/aidebug-options-selftest.mjs",
    "test:image-layout": "node scripts/image-layout-selftest.ts",
    "test:image-container": "node scripts/image-container-selftest.ts",
    "test:image-stream-preview": "node scripts/streaming-image-preview-selftest.ts",
    "test:requirement-signature": "node scripts/requirement-signature-selftest.ts",
    "test:requirement-graph": "node scripts/requirement-graph-selftest.ts",
    "test:task-scope": "node scripts/task-scope-selftest.ts",
    "test:execution-gate": "node scripts/execution-gate-selftest.ts",
    "test:ui-foundation": "node scripts/ui-foundation-selftest.cjs",
    "test:chroma-key": "node scripts/chroma-key-selftest.ts",
    "test:layer-alpha": "node scripts/layer-alpha-selftest.ts",
    "test:layer-mask-replay": "node scripts/layer-mask-replay-selftest.ts",
    "test:semantic-matting": "node scripts/semantic-matting-selftest.cjs",
    "test:selection": "node scripts/selection-state-selftest.ts",
    "test:canvas-commands": "node scripts/canvas-command-selftest.ts",
    "test:asset-identity": "node scripts/asset-identity-selftest.ts",
    "test:timeline": "node scripts/tool-timeline-selftest.ts",
    "test:psd-export": "node scripts/psd-export-selftest.cjs",
    "test:thumbnail-cache": "node scripts/thumbnail-cache-selftest.cjs",
    "test:image-import": "node scripts/image-import-selftest.cjs",
    "test:ipc-registration": "node scripts/ipc-registration-selftest.cjs",
    "test:account-token": "node scripts/account-token-selftest.cjs",
    "test:automation-service": "node scripts/automation-service-selftest.cjs",
    "test:agent-integration": "node scripts/agent-integration-selftest.cjs",
    "test:lifecycle": "node scripts/electron-lifecycle-selftest.cjs",
    "test:update": "electron scripts/desktop-update-selftest.cjs",
    "test:update-rollback": "electron scripts/desktop-update-rollback-selftest.cjs",
    "test:update-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/update-helper-selftest.ps1",
    "test:bundle": "node scripts/production-bundle-selftest.cjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "release:assets": "node scripts/release/generate-installer-assets.mjs",
    "release:update-key": "node scripts/release/generate-update-keypair.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:production:image-edit": "node scripts/production-managed-image-edit-e2e.mjs",
    "release:plan": "node scripts/release/windows-release-orchestrator.mjs --print-plan",
    "release:final": "node scripts/release/windows-release-orchestrator.mjs",
    "test:release-orchestrator": "node scripts/release/windows-release-orchestrator.mjs --selftest",
    "release:manifest": "node scripts/release/create-update-release.mjs",
    "package:dir": "pnpm run build && pnpm run release:assets && node scripts/release/build-windows.mjs --dir",
    "package:installer-smoke": "node scripts/release/installer-smoke.mjs",
    "package:installer-ui-smoke": "node scripts/release/branded-installer-ui-smoke.mjs",
    "package:smoke": "node scripts/release/packaged-smoke.mjs",
    "package:update-e2e": "node scripts/release/restart-update-e2e.mjs",
    "package:win": "pnpm run build && pnpm run test:bundle && pnpm run release:assets && node scripts/release/build-windows.mjs --nsis && pnpm run package:installer-ui-smoke",
    "package:release": "pnpm run release:final",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "ag-psd": "31.0.2",
    "lucide-react": "^0.468.0",
    "pngjs": "7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "26.0.12",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "org.sparkai.naimage",
    "productName": "naimage",
    "executableName": "naimage",
    "copyright": "Copyright © 2026 SparkAI",
    "asar": true,
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "forceCodeSigning": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "desktop/**/*",
      "integrations/**/*",
      "runtime/**/*",
      "preload.cjs",
      "agent-window.html",
      "agent-window.css",
      "agent-window-renderer.js",
      "agent-window-preload.cjs",
      "agent-runtime.cjs",
      "background-removal.cjs",
      "image-import.cjs",
      "image-import-worker.cjs",
      "image-thumbnail-worker.cjs",
      "psd-export.cjs",
      "psd-export-worker.cjs",
      "psd-raster-source-worker.cjs",
      "semantic-matting.cjs",
      "semantic-matting-worker.cjs",
      "thumbnail-cache.cjs",
      "update-release.cjs",
      "build/update-public-key.pem",
      "public/naimage.png",
      "package.json",
      "!**/.v8-cache/**"
    ],
    "extraResources": [
      {
        "from": "build/update-helper.ps1",
        "to": "update-helper.ps1"
      },
      {
        "from": "build/update-launcher.ps1",
        "to": "update-launcher.ps1"
      }
    ],
    "asarUnpack": [
      "**/*-worker.cjs",
      "**/node_modules/**/*.node",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/naimage.ico",
      "artifactName": "naimage-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "guid": "887890c3-49de-5e86-9a32-28781d680b7f",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "naimage",
      "uninstallDisplayName": "naimage",
      "installerIcon": "build/naimage.ico",
      "uninstallerIcon": "build/naimage.ico",
      "installerHeaderIcon": "build/naimage.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
