[
  {
    "schemaVersion": 1,
    "id": "sparkai.commerce-toolkit",
    "name": "跨境电商多语言工具",
    "version": "1.0.0",
    "publisher": "SparkAI",
    "description": "把当前选中的商品图按多个目标语言生成独立本地化套图。",
    "permissions": [
      "canvas.read-selection",
      "agent.submit-task",
      "canvas.write-results"
    ],
    "contributes": {
      "commands": [
        {
          "id": "sparkai.commerce-toolkit.translate-listing-set",
          "title": "一键翻译多国语言套图",
          "description": "保持商品、品牌和版式不变，按目标语言分别生成本地化图片成果。",
          "requiredPermissions": [
            "canvas.read-selection",
            "agent.submit-task",
            "canvas.write-results"
          ]
        }
      ],
      "toolbar": [
        {
          "id": "commerce-translate-listing-set",
          "command": "sparkai.commerce-toolkit.translate-listing-set",
          "label": "套图翻译",
          "description": "一键生成多国语言商品套图",
          "group": "commerce",
          "order": 10,
          "when": "canvas.has-image-selection"
        }
      ]
    }
  },
  {
    "schemaVersion": 1,
    "id": "sparkai.project-graph",
    "name": "Project Graph 视觉学习",
    "version": "1.0.0",
    "publisher": "SparkAI",
    "description": "只读导入 Project Graph 思维导图，把概念与关系转化为更具体、更容易学习记忆的图片成果。",
    "permissions": [
      "project.read-graph",
      "agent.submit-task",
      "canvas.write-results"
    ],
    "contributes": {
      "commands": [
        {
          "id": "sparkai.project-graph.visualize-learning-map",
          "title": "思维导图转学习图片",
          "description": "选择 .prg 或图结构 JSON，由 Agent 分析概念关系并生成视觉学习图片。",
          "requiredPermissions": [
            "project.read-graph",
            "agent.submit-task",
            "canvas.write-results"
          ]
        }
      ],
      "toolbar": [
        {
          "id": "project-graph-visualize-learning-map",
          "command": "sparkai.project-graph.visualize-learning-map",
          "label": "思维导图转图片",
          "description": "导入 Project Graph 并生成视觉学习图片",
          "group": "learning",
          "order": 20
        }
      ]
    }
  }
]
