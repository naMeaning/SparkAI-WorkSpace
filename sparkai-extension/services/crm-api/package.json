{
  "name": "@ai-native/crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx src/scripts/dev-memory.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "smoke:real": "tsx src/scripts/smoke-real.ts",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@ai-native/crm-contracts": "workspace:*",
    "@ai-native/shared": "workspace:*",
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
