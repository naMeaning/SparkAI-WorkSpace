SPARKAI_EXTENSION_HOST=0.0.0.0
SPARKAI_EXTENSION_PORT=17910
SPARKAI_EXTENSION_DATA_DIR=/data

# Generate two independent values with at least 32 random characters.
SPARKAI_EXTENSION_ADMIN_TOKEN=replace-with-a-long-random-admin-token
SPARKAI_EXTENSION_HASH_SECRET=replace-with-a-stable-long-random-hmac-secret

# Optional exact origins allowed to embed the License admin page (comma-separated).
# Leave empty to keep the page unavailable inside iframes.
SPARKAI_EXTENSION_ADMIN_FRAME_ORIGINS=

# Use the stock New API container DNS name on their shared Docker network.
# Never point this back through the Cloudflare public hostname.
SPARKAI_NEW_API_UPSTREAM=http://new-api:3000
SPARKAI_IMAGE_CONCURRENCY=2
SPARKAI_IMAGE_TIMEOUT_MS=600000
SPARKAI_MAX_REQUEST_BYTES=2097152
SPARKAI_MAX_RESULT_BYTES=100663296
SPARKAI_TASK_RETENTION_HOURS=24
SPARKAI_TRUST_PROXY=1
